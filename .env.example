# ------------------------------------------------------------------------------
# Lead Discovery SaaS - Environment Configuration
# ------------------------------------------------------------------------------

# Supabase Credentials (Optional for local testing - built-in resilient mock store active by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Directory Scraping APIs (Configure in Dashboard Settings or directly here)
GOOGLE_PLACES_API_KEY=your-google-places-api-key
SERPAPI_API_KEY=your-serpapi-api-key
APIFY_API_KEY=your-apify-api-key

# AI Intelligence API
OPENAI_API_KEY=your-openai-api-key

# Scheduled Automation Secret (Used for Vercel Cron or QStash authorization)
CRON_SECRET=your_secure_cron_trigger_secret_key

# Notifications
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=alerts@yourdomain.com
