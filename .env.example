# Required: MongoDB Atlas connection string and owner dashboard password.
MONGODB_URI=
MONGODB_DB=araknet
DASHBOARD_PASSWORD=
# Required for Vercel's daily cron; keep secret. Schedule is disabled by default.
CRON_SECRET=
# Optional directory providers. Without keys, real OpenStreetMap results are used.
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=
